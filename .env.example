VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_N8N_WEBHOOK_URL=your_n8n_webhook_base_url

# Tenant resolution
# Production root domain (e.g. dashboard.com). Subdomains are stripped to derive the client slug.
VITE_ROOT_DOMAIN=
# Fallback slug used on localhost / apex domain / when no subdomain is present.
VITE_DEFAULT_CLIENT_SLUG=demo
